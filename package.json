{
  "name": "cukup-theme",
  "version": "1.0.0",
  "description": "Essentialist multi-platform design system & theme for Alacritty, Zed, VS Code, iTerm2, and more.",
  "main": "build.js",
  "scripts": {
    "build": "node build.js",
    "build:alacritty": "node build.js --target alacritty",
    "build:zed": "node build.js --target zed",
    "build:vscode": "node build.js --target vscode",
    "build:iterm": "node build.js --target iterm",
    "build:kitty": "node build.js --target kitty",
    "build:zellij": "node build.js --target zellij",
    "build:web": "node build.js --target web",
    "build:tailwind": "node build.js --target tailwind",
    "build:telegram": "node build.js --target telegram",
    "build:t3code": "node build.js --target t3code",
    "build:herdr": "node build.js --target herdr",
    "preview": "./print_colors.sh"
  },
  "keywords": [
    "theme",
    "alacritty",
    "zed",
    "vscode",
    "iterm2",
    "design-system",
    "minimalist",
    "dark-theme"
  ],
  "author": "Hasan Suryaman",
  "license": "MIT"
}
